APP_ENV=development
PORT=8080

# Either set DATABASE_URL (preferred on Railway/Heroku/Render — takes priority
# if present) OR the discrete DB_* vars below for local/self-hosted Postgres.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sales_system
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=720

# Comma-separated allow-list, e.g. https://crm.yourdomain.com — restrict this
# in production instead of leaving the "*" (any origin) default.
CORS_ORIGINS=*

# SMTP settings for the Task due-date email reminder feature. If SMTP_HOST is
# left unset/empty, email is disabled (logged once at startup; sends silently
# no-op) and alerts are in-app only — set all five in production to
# actually send reminder emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apikey-or-username
# SMTP_PASSWORD=changeme
# SMTP_FROM=crm@yourdomain.com

# Reverse proxies whose X-Forwarded-For the login rate limiter trusts
# (comma-separated IPs/CIDRs, or "none"). Unset = Railway's private ranges
# when running on Railway, nothing elsewhere — see README.
# TRUSTED_PROXIES=10.0.0.0/8

# Password for the Admin seeded on first boot (empty users table). Unset =
# generated and printed once; must be changed at first login either way.
# ADMIN_INITIAL_PASSWORD=

# Postgres pool limits per instance (defaults shown).
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m
