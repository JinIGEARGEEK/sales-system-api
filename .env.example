APP_ENV=development
PORT=8080

# Either set DATABASE_URL (preferred on Railway/Heroku/Render — takes priority
# if present) OR the discrete DB_* vars below for local/self-hosted Postgres.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sales_system
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=720

# Comma-separated allow-list, e.g. https://crm.yourdomain.com — restrict this
# in production instead of leaving the "*" (any origin) default.
CORS_ORIGINS=*

# SMTP settings for the Task due-date email reminder feature. If SMTP_HOST is
# left unset/empty, the mailer no-ops (logs a warning instead of sending) so
# the app runs fine without these configured — set all five in production to
# actually send reminder emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apikey-or-username
# SMTP_PASSWORD=changeme
# SMTP_FROM=crm@yourdomain.com
